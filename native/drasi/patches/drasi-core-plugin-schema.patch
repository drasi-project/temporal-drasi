+                {"type": "object", "properties": {
+                    "kind": {"type": "string", "enum": ["Secret"]},
+                    "name": {"type": "string"}
+                }, "required": ["kind", "name"], "additionalProperties": false},
+                {"type": "object", "properties": {
+                    "kind": {"type": "string", "enum": ["EnvironmentVariable"]},
+                    "name": {"type": "string"},
+                    "default": {"type": "string"}
+                }, "required": ["kind", "name"], "additionalProperties": false}
