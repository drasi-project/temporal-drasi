+        );
+        let number = serde_json::to_value(ConfigValue::<u16>::schema()).unwrap();
+        assert_eq!(number["anyOf"][0]["type"], "integer");
+        assert_eq!(number["anyOf"][1], schema["anyOf"][1]);
+        assert_eq!(number["anyOf"][2], schema["anyOf"][2]);
