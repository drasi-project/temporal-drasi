+        }
+        drop(rows);
+        drop(store);
+        gate.release.notify_one();
+        stop.await.unwrap();
+    }
+    assert_eq!(query.status().await, ComponentStatus::Stopped);
+    assert_eq!(removed.load(Ordering::Acquire), 1);
+    drop(query);
