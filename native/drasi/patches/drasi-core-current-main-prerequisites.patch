+    assert_eq!(*resume_sequence.read().await, Some(1));
+    let query = reopened
+        .query_manager()
+        .get_query_instance("warm-q")
+        .await
+        .unwrap();
+    let outbox = query.fetch_outbox(0).await.unwrap();
