+#[async_trait]
+impl super::Query for RetirementTestQuery {
+    async fn start(&self) -> anyhow::Result<()> {
+        self.inner.start().await
+    }
+    async fn stop(&self) -> anyhow::Result<()> {
+        self.inner.stop().await
+    }
+    async fn status(&self) -> ComponentStatus {
